QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
LLM_PROVIDER=ollama
LLM_MODEL=qwen3:8b
GEMINI_MODEL=gemini-3.8-flash
OLLAMA_BASE_URL=http://localhost:11434
EMBEDDING_MODEL=BAAI/bge-m3
COLLECTION_NAME=rd_engineering
API_HOST=127.0.0.1
API_PORT=8000
API_URL=http://127.0.0.1:8000
LOG_LEVEL=INFO
INCOMING_DOCUMENTS_DIR=documents/incoming
PROCESSED_DOCUMENTS_DIR=documents/processed
INGESTION_CHUNK_SIZE=1600
INGESTION_CHUNK_OVERLAP=200
DOCLING_OFFLINE=true

# ---------------------------------------------------------------------------
# INFINITY AI platform (Docker Compose). start.ps1 appends any missing values below to your real .env
# and NEVER overwrites existing ones. Settings above (GEMINI_API_KEY, GEMINI_MODEL, ...) are reused as-is.
# ---------------------------------------------------------------------------
# Generated by start.ps1 on first run:
# APP_SECRET_KEY=                 # encrypts stored API keys/credentials. If you change it, stored keys become unreadable.
# POSTGRES_PASSWORD=
# BOOTSTRAP_ADMIN_EMAIL=admin@infinity.local
# BOOTSTRAP_ADMIN_PASSWORD=       # used only when no users exist yet
# WEB_PORT=8088                   # the only port the platform publishes on your PC
# Where containers reach your EXISTING Qdrant (auto-detected by start.ps1 from the infinity-qdrant container):
# PLATFORM_QDRANT_URL=http://host.docker.internal:6333
# Optional:
# PLATFORM_OLLAMA_URL=http://host.docker.internal:11434
# LEGACY_DOCUMENT_VISIBILITY=internal   # visibility given to the pre-existing documents (public|internal|confidential)
# ALLOW_PRIVATE_NETWORK_SOURCES=false   # true lets Website/API sources reach private/LAN addresses (SSRF risk)
# COOKIE_SECURE=false                   # set true when served over HTTPS
# EMBEDDER_THREADS=6                    # CPU threads for BGE-M3 (i7-1265U: 6 leaves room for the rest of the system)
